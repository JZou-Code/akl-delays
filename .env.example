# Copy this file to .env in the repository root to change a value.
# An empty value uses the default.

# The API listens on this port. The web dev server sends /api requests to it.
PORT=3000

# fixture reads the files in apps/api/fixtures. at calls the Auckland Transport API.
FEED_SOURCE=fixture

# Needed only when FEED_SOURCE=at. Never commit a real key.
AT_API_KEY=

# Seconds between two calls to the feed. AT allows 35,000 calls a week,
# so the API refuses to start below 18.
POLL_INTERVAL_SECONDS=60

# A trip whose last update is older than this, measured against the feed's
# own time, is left out. The feed keeps trips for hours after they end.
MAX_UPDATE_AGE_SECONDS=1200

# Folder that holds routes.txt and stops.txt. Empty uses apps/api/fixtures/gtfs.
GTFS_DIR=
